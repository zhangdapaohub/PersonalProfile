              "q": { "text": "列出你能拿出去换钱的技能，各打几分（1-5）？有证书/作品佐证吗？", "probe": [] } },
            { "path": "capability.skills.languages", "name": "语言能力", "type": "fact", "input": "textarea", "volatile": false,
              "q": { "text": "会哪些语言/方言？各到什么程度（日常/工作/母语级）？", "probe": [] } }
          ]
        },
        {
          "key": "education",
          "name": "教育经历",
          "metrics": [
