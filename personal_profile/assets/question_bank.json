{
  "version": "0.1.0-p0",
  "label": "P0 核心画像",
  "note": "提问库 P0：每指标一题。指标的 path/中文名/单位为本文件唯一权威定义（指标注册表），展示层经 /api/schema 合并后引用。maps_to 即指标 path。",
  "domains": [
    {
      "key": "identity",
      "name": "身份与存在",
      "dimensions": [
        {
          "key": "basic",
          "name": "基本信息",
          "metrics": [
            { "path": "identity.basic.full_name", "name": "姓名", "type": "fact", "input": "text", "volatile": false,
              "q": { "text": "你的姓名？曾用名、昵称、常用网名也可一并列出。", "probe": [] } },
            { "path": "identity.basic.birth_date", "name": "出生日期", "type": "fact", "input": "date", "volatile": false,
              "q": { "text": "你的出生日期？（农历/阳历可注明）", "probe": [] } },
            { "path": "identity.basic.birthplace", "name": "出生地", "type": "fact", "input": "text", "volatile": false,
              "q": { "text": "你出生在哪里？（省市/医院/家里均可）", "probe": [] } },
            { "path": "identity.basic.current_city", "name": "现居城市", "type": "fact", "input": "text", "volatile": true,
              "q": { "text": "你现在定居在哪个城市？住了多久？", "probe": ["之前在哪些城市长期生活过？"] } }
          ]
        },
        {
          "key": "origin",
          "name": "出身溯源",
          "metrics": [
            { "path": "identity.origin.name_story", "name": "名字由来", "type": "story", "input": "textarea", "volatile": false,
              "q": { "text": "你的名字是谁起的？有什么含义或故事？", "probe": ["你喜欢自己的名字吗？"] } },
            { "path": "identity.legal.marital_status", "name": "婚姻状况", "type": "fact", "input": "select",
              "options": ["未婚", "恋爱中", "已婚", "离异", "丧偶"], "volatile": true,
              "q": { "text": "你目前的婚姻/感情状况？", "probe": [] } }
          ]
        },
        {
          "key": "tags",
          "name": "一句话身份",
          "metrics": [
            { "path": "identity.tags.self_intro", "name": "一句话自我介绍", "type": "story", "input": "textarea", "volatile": false,
              "q": { "text": "如果只能用一句话介绍自己，你会怎么说？", "probe": [] } },
            { "path": "identity.tags.three_words", "name": "三个标签词", "type": "fact", "input": "text", "volatile": false,
              "q": { "text": "用三个词概括你自己（逗号分隔）。", "probe": [] } }
          ]
        }
      ]
    },
    {
      "key": "body",
      "name": "身体",
      "dimensions": [
        {
          "key": "appearance",
          "name": "外貌体征",
          "metrics": [
            { "path": "body.appearance.height", "name": "身高", "type": "fact", "input": "number", "unit": "cm", "volatile": false,
              "q": { "text": "你的身高？", "probe": [] } },
            { "path": "body.appearance.weight", "name": "体重", "type": "fact", "input": "number", "unit": "kg", "volatile": true,
              "q": { "text": "你目前的体重？（自报值，体检实测走 InBody 导入）", "probe": [] } },
            { "path": "body.appearance.self_rating", "name": "体型自评", "type": "eval", "input": "rating", "volatile": false,
              "q": { "text": "给自己现在的体型打分（1=很不满意，5=很满意）。", "probe": ["最想改变哪一点？"] } }
          ]
        },
        {
          "key": "health",
          "name": "健康",
          "metrics": [
            { "path": "body.health.chronic_allergy", "name": "慢性病与过敏", "type": "fact", "input": "textarea", "volatile": true,
              "q": { "text": "有哪些慢性病、过敏源或长期在用的药？（没有写\"无\"）", "probe": [] } },
            { "path": "body.health.family_history", "name": "家族病史", "type": "fact", "input": "textarea", "volatile": false,
              "q": { "text": "直系亲属有哪些值得注意的病史？（没有写\"无\"）", "probe": [] } }
          ]
        },
        {
          "key": "sleep",
          "name": "睡眠",
          "metrics": [
            { "path": "body.sleep.bedtime", "name": "通常入睡时间", "type": "fact", "input": "text", "volatile": true,
              "q": { "text": "工作日你通常几点睡、几点起？", "probe": ["周末会差多少？"] } },
            { "path": "body.sleep.quality", "name": "睡眠质量自评", "type": "eval", "input": "rating", "volatile": true,
              "q": { "text": "给自己的睡眠质量打分（1=很差，5=很好）。", "probe": ["入睡难还是易醒？"] } }
          ]
        },
        {
          "key": "energy",
          "name": "精力",
          "metrics": [
            { "path": "body.energy.peak_hours", "name": "精力最佳时段", "type": "fact", "input": "select",
              "options": ["清晨", "上午", "下午", "傍晚", "深夜"], "volatile": false,
              "q": { "text": "一天中你状态最好的时段是？", "probe": ["起来后多久才算真正\"清醒\"？"] } },
            { "path": "body.energy.recovery", "name": "恢复方式", "type": "story", "input": "textarea", "volatile": false,
              "q": { "text": "累了之后，你最有效的恢复方式是什么？", "probe": [] } }
          ]
        },
        {
          "key": "medical",
          "name": "医疗检测",
          "metrics": [
            { "path": "body.medical.last_checkup_flags", "name": "最近体检异常项", "type": "fact", "input": "textarea", "volatile": true,
              "q": { "text": "最近一次体检有哪些异常或复查项？（报告可后补作佐证）", "probe": ["有安排复查吗？"] } }
          ]
        }
      ]
    },
    {
      "key": "mind",
      "name": "心理与内在",
      "dimensions": [
        {
          "key": "personality",
          "name": "性格",
          "metrics": [
            { "path": "mind.personality.self_words", "name": "性格自述三词", "type": "fact", "input": "text", "volatile": false,
              "q": { "text": "用三个词形容你的性格（逗号分隔）。", "probe": [] } },
            { "path": "mind.personality.strengths", "name": "最大优点", "type": "story", "input": "textarea", "volatile": false,
              "q": { "text": "你最大的优点是什么？举一件能证明它的事。", "probe": [] } },
            { "path": "mind.personality.weaknesses", "name": "最大缺点", "type": "story", "input": "textarea", "volatile": false,
              "q": { "text": "你最大的缺点是什么？它给你造成过的最大麻烦是？", "probe": ["想过怎么改吗？"] } },
            { "path": "mind.personality.other_view", "name": "他评反差", "type": "eval", "input": "textarea", "perspective": "other", "volatile": false,
              "q": { "text": "最了解你的人会用哪三个词形容你？和你自述的差在哪？", "probe": ["你希望他们用的是哪三个？"] } }
          ]
        },
        {
          "key": "values",
          "name": "价值观",
          "metrics": [
            { "path": "mind.values.money", "name": "金钱观", "type": "story", "input": "textarea", "volatile": false,
              "q": { "text": "钱对你意味着什么？赚够多少你会换一种活法？", "probe": [] } },
            { "path": "mind.values.bottom_line", "name": "是非底线", "type": "story", "input": "textarea", "volatile": false,
              "q": { "text": "有什么事给再多钱你也不做？", "probe": [] } },
            { "path": "mind.values.admire", "name": "最敬佩的人", "type": "story", "input": "textarea", "volatile": false,
              "q": { "text": "你最敬佩谁？为什么？（认识的人或公众人物均可）", "probe": [] } }
          ]
        },
        {
          "key": "emotion",
          "name": "情绪",
          "metrics": [
            { "path": "mind.emotion.anger_pattern", "name": "生气时的样子", "type": "story", "input": "textarea", "volatile": false,
              "q": { "text": "你生气时外人看得出来吗？典型表现是什么？", "probe": ["最近一次真的动怒是因为什么？"] } },
            { "path": "mind.emotion.stress_pattern", "name": "压力反应", "type": "story", "input": "textarea", "volatile": false,
              "q": { "text": "压力大到快扛不住时，你的身体和行为会有什么反应？", "probe": ["你用什么方法把自己拉回来？"] } }
          ]
        },
        {
          "key": "desire",
          "name": "欲望与恐惧",
          "metrics": [
            { "path": "mind.desire.top_desires", "name": "最渴望的三件事", "type": "fact", "input": "textarea", "volatile": true,
              "q": { "text": "现阶段你最渴望得到/实现的三件事？", "probe": [] } },
            { "path": "mind.desire.fears", "name": "最深的恐惧", "type": "story", "input": "textarea", "volatile": false,
              "q": { "text": "你最深的恐惧是什么？它最早出现在什么时候？", "probe": ["它影响过你的哪个重大决定？"] } }
          ]
        },
        {
          "key": "belief",
          "name": "信念",
          "metrics": [
            { "path": "mind.belief.life_motto", "name": "人生信条", "type": "story", "input": "textarea", "volatile": false,
              "q": { "text": "有没有一句话支撑你很多年？它从哪来的？", "probe": [] } },
            { "path": "mind.belief.worldview", "name": "世界观", "type": "story", "input": "textarea", "volatile": false,
              "q": { "text": "你更相信人性本善还是本恶？世界是公平的吗？", "probe": ["什么事让你变成这样？"] } }
          ]
        }
      ]
    },
    {
      "key": "capability",
      "name": "能力与知识",
      "dimensions": [
        {
          "key": "skills",
          "name": "技能",
