            { "path": "capability.education.major_reason", "name": "专业选择原因", "type": "story", "input": "textarea", "volatile": false,
              "q": { "text": "当初为什么选这个专业？现在后悔吗？", "probe": [] } }
          ]
        },
        {
          "key": "knowledge",
          "name": "知识结构",
          "metrics": [
            { "path": "capability.knowledge.expertise", "name": "能讲半小时的话题", "type": "fact", "input": "textarea", "volatile": false,
              "q": { "text": "哪些话题你能不备课讲半小时？（专业或业余均可）", "probe": [] } }
          ]
        },
        {
          "key": "expression",
          "name": "表达",
          "metrics": [
            { "path": "capability.expression.style", "name": "说话风格", "type": "fact", "input": "select",
              "options": ["直接了当", "委婉含蓄", "看人下菜", "话多爱聊", "惜字如金"], "volatile": false,
              "q": { "text": "你的说话风格更接近哪种？有口头禅吗？", "probe": [] } }
          ]
        },
        {
          "key": "habits",
          "name": "习惯",
          "metrics": [
            { "path": "capability.habits.routine", "name": "每日例行", "type": "story", "input": "textarea", "volatile": true,
              "q": { "text": "你雷打不动的日常惯例有哪些？（哪怕很小）", "probe": [] } },
            { "path": "capability.habits.procrastination", "name": "拖延模式", "type": "story", "input": "textarea", "volatile": false,
              "q": { "text": "你拖什么事情最严重？拖到什么程度才动手？", "probe": [] } }
          ]
        }
      ]
    },
    {
      "key": "relations",
